# ==========================================
# JALALI COSMETICS - ENVIRONMENT CONFIGURATION
# ==========================================

NODE_ENV=development

# Storefront
NEXT_PUBLIC_SITE_NAME=JALALI COSMETICS
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Backend
DJANGO_SETTINGS_MODULE=config.settings
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/jalali_cosmetics

# Security
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# Redis
REDIS_URL=redis://localhost:6379/0

# Payments - configure with real merchant credentials
PAYMENT_PROVIDER=
PAYMENT_MERCHANT_ID=
PAYMENT_CALLBACK_URL=

# Shipping
SHIPPING_PROVIDER=
SHIPPING_API_KEY=

# File storage
STORAGE_PROVIDER=local
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Notifications
SMS_PROVIDER=
SMS_API_KEY=

# Initial admin (development only)
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
